# Copy to .env.local. Local work only ever points at Docker Postgres (compose.yaml).
DATABASE_URL=postgres://fat:fat@localhost:54329/fat_controller
DATABASE_URL_UNPOOLED=postgres://fat:fat@localhost:54329/fat_controller

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seed-only: director accounts (comma-separated "Name <email>") and their initial password.
DIRECTOR_ACCOUNTS=Alice <alice@example.com>,Bob <bob@example.com>
DIRECTOR_INITIAL_PASSWORD=
