# Copy to .env.local. Local work only ever points at Docker Postgres (compose.yaml).
DATABASE_URL=postgres://fat:fat@localhost:54329/fat_controller
DATABASE_URL_UNPOOLED=postgres://fat:fat@localhost:54329/fat_controller

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seed-only: director accounts (comma-separated "Name <email>") and their initial password.
DIRECTOR_ACCOUNTS=Alice <alice@example.com>,Bob <bob@example.com>
DIRECTOR_INITIAL_PASSWORD=

# Xero (M1). Starter-plan app at developer.xero.com; redirect URI <origin>/api/xero/callback.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# openssl rand -base64 32. Encrypts the stored Xero refresh token (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 32. Bearer token for /api/cron/sync (Vercel Cron sends it automatically).
CRON_SECRET=

# Solidtime (forecast). The token must belong to a director with the owner, admin or manager role.
SOLIDTIME_API_URL=https://app.solidtime.io/api/v1
SOLIDTIME_API_TOKEN=
SOLIDTIME_ORGANIZATION_ID=
